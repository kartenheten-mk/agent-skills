{
  "root": true,
  "extends": "airbnb-base",
  "env": {
    "browser": true
  },
  "globals": {
    "Origo": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "comma-dangle": [
      "error",
      "never"
    ],
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "js": "always",
        "json": "always"
      }
    ],
    "import/no-cycle": "off",
    "import/no-unresolved": "off",
    "max-len": "off",
    "max-lines": [
      "error",
      {
        "max": 500,
        "skipBlankLines": false,
        "skipComments": false
      }
    ],
    "new-cap": "off",
    "no-console": [
      "error",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "no-else-return": [
      "error",
      {
        "allowElseIf": true
      }
    ],
    "object-curly-newline": "off",
    "prefer-destructuring": "off",
    "prefer-object-spread": "off"
  }
}
